#
# Records that sysntpd has synchronised the clock, for /usr/libexec/ipad/ready. Stratum 16 means unsynchronised.

[ "$ACTION" = stratum ] || [ "$ACTION" = step ] || return 0
[ "$ACTION" = stratum ] && [ "$stratum" = 16 ] && return 0

mkdir -p /var/run/ipad
touch /var/run/ipad/ntp-synced
