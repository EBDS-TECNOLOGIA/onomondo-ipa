{
	"_comment": "IPAd configuration. Copy to /etc/ipad/config.json; the daemon notices changes by itself. Keys starting with _ are ignored.",

	"tac": "12345678",

	"_transport": "how the eUICC is reached: \"at:/dev/ttyUSB2\" for a modem (AT+CSIM), \"pcsc:0\" for a card reader. AT options: ?timeout=MS&baud=RATE&reset=none|cfun&resetwait=MS",
	"transport": "at:/dev/ttyUSB2",
	"_reader_num": "used only by the pcsc transport when the URI does not carry a reader number",
	"reader_num": 0,

	"_euicc_channel": "\"auto\" lets the eUICC pick the logical channel, which is what a modem needs; a number asks for that channel, 0 uses the basic channel",
	"euicc_channel": "auto",
	"_preferred_eim_id": "set to the eimId to use when the eUICC has several; absent: the first one",

	"esipa_binding": "asn1",
	"esipa_req_retries": 3,
	"eim_disable_ssl_verif": false,

	"_poll_interval": "seconds between poll cycles, at least 5; 0 runs one cycle and stops",
	"poll_interval": 900,
	"poll_interval_unit": "seconds",

	"_nvstate_path": "relative to /etc/ipad, which is kept across sysupgrade",
	"nvstate_path": "nvstate.bin",

	"log": {
		"level": "info",
		"subsys_levels": { "_example": "HTTP: debug" }
	},

	"platform": {
		"_wan_interfaces": "polling waits until one of these netifd interfaces is up; empty: until any interface provides a default route",
		"wan_interfaces": [],
		"require_wan": true,
		"_require_ntp": "wait for the NTP client to synchronise the clock (ignored when the NTP client is disabled)",
		"require_ntp": true,
		"_wan_settle": "seconds to wait after a profile change before checking the WAN again",
		"wan_settle": 30,
		"_restart_on_profile_change": "run ifup on these interfaces after a profile change",
		"restart_on_profile_change": []
	}
}
